REMARK Run with BASIC DEMO (one BASIC.COM, no intermediate .INT file).
PRINT "BASIC-E DIRECT-SOURCE SUBSET"
DIM SQUARE(5)
DATA "Ada",3,4
READ NAME$,A,B
PRINT "HELLO ";NAME$;": HYPOTENUSE = ";SQR(A*A+B*B)
FOR INDEX=0 TO 5
  SQUARE(INDEX)=INDEX^2
NEXT INDEX
FOR INDEX=5 TO 0 STEP -1
  PRINT INDEX;": ";SQUARE(INDEX)
NEXT INDEX
IF A<B THEN \
  IF B=4 THEN PRINT "NESTED IF OK":GOSUB 100 \
  ELSE PRINT "BAD INNER BRANCH" \
ELSE PRINT "BAD OUTER BRANCH"
PRINT LEFT$(NAME$,1)+"."+MID$(NAME$,2)
END
100 PRINT "SUBROUTINE OK"
RETURN
